# Local: aponta pro Postgres do docker-compose. Em produção (Neon): DATABASE_URL é a
# connection string com "-pooler" (pgbouncer), DIRECT_URL é a connection string direta
# (usada só pelo `prisma migrate`). Localmente as duas podem ser iguais.
DATABASE_URL="postgresql://postgres:postgres@localhost:5442/cogni-local?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5442/cogni-local?schema=public"

AUTH_SECRET="gere-com-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3010"
