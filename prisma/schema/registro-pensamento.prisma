enum Emocao {
  ANSIEDADE
  TRISTEZA
  RAIVA
  MEDO
  VERGONHA
  CULPA
  FRUSTRACAO
  ALEGRIA
  OUTRO

  @@map("emocao")
}

model RegistroPensamento {
  id Int @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  situacao   String @db.Text
  pensamento String @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  emocoes RegistroPensamentoEmocao[]

  @@index([usuarioId], name: "idx_registro_pensamento_usuario_id_usuario")
  @@map("registroPensamento")
}

model RegistroPensamentoEmocao {
  id Int @id @default(autoincrement())

  registroPensamentoId Int
  registroPensamento   RegistroPensamento @relation(fields: [registroPensamentoId], references: [id], onDelete: Cascade)

  emocao      Emocao
  intensidade Int @db.SmallInt

  @@index([registroPensamentoId], name: "idx_registro_pensamento_emocao_registro_pensamento_id")
  @@map("registroPensamentoEmocao")
}
